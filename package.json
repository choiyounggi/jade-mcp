{
  "name": "jade-mcp",
  "version": "0.3.0",
  "description": "JADE eHR 를 Claude Code 같은 MCP 클라이언트에서 쓰게 해 주는 로컬 MCP 서버 (macOS)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choiyounggi/jade-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "jade",
    "ehr",
    "macos"
  ],
  "bin": {
    "jade-mcp": "bin/jade-mcp.cjs"
  },
  "files": [
    "bin/jade-mcp.cjs",
    "bin/node-min.cjs",
    "dist",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "start": "bin/jade-mcp",
    "setup": "bin/jade-mcp-setup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "os": [
    "darwin"
  ]
}
